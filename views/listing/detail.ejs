<% layout("/layouts/boilerplate") %>
<body>
     <h3>Listing detail</h3>
   <div class="detalis">
    <b><%=listing.eventName%></b><br>
    
    <%= listing.foodType %> 
    <p><%= listing.portionsKg %>Kg available</p>
    <p><%= listing.distanceKm %>Km away</p>
    <p>Expires in <%= listing.expiryHours %></p>
    <a href="/listing/<%= listing._id %>/edit">
        <button >Edit</button>
        </a>
        <form action="/listing/<%= listing._id %>?_method=DELETE" method="POST">
            <button>Delete</button>
         </form>
  </div>

</body>
</html>